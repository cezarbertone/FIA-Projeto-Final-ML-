# O código-fonte é montado por volume em runtime.
# Estes itens não precisam viajar no contexto de build.
.git
.gitignore
.vscode
.idea
__pycache__
**/__pycache__
*.pyc
.ipynb_checkpoints
**/.ipynb_checkpoints

# Dados grandes adicionados manualmente
Landing/*.csv
Dados/*.csv
Dados/_processing/*
!Dados/_processing/.gitkeep

# Artefatos gerados
Model/*.pkl
Model/*.json
reports/*
!reports/.gitkeep

DataPipeline/abt_artifacts.pkl
